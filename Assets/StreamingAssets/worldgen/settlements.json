{
  "schema": "litiso.worldgen.settlements.v1",
  "_": "Settlement placement contract. Farther from spawn means lower frequency, larger footprint, higher service tier, and richer stock.",
  "distanceMetric": "chunk-ring-from-spawn",
  "globalRules": {
    "minimumSettlementSpacingChunks": 8,
    "preferBiomeOrder": [
      "meadow",
      "forest-edge",
      "coast",
      "mountain-foot"
    ],
    "avoidBiomeTags": [
      "deep_forest",
      "snow_peak",
      "wet_sand",
      "dungeon"
    ],
    "requiredFlatness": "max height delta 0 inside plaza, max delta 1 at settlement edge",
    "roadPolicy": "one main road spine, side paths to doors, at least two exits to wilderness",
    "doorClearanceCells": 3,
    "wellOrCampfireCenter": true
  },
  "bands": [
    {
      "id": "hearthclaim_spawn",
      "chunkRing": [0, 2],
      "chancePerEligibleChunk": 0.0,
      "sizeClass": "spawn-safe",
      "maxBuildings": 0,
      "stockTier": 0,
      "rule": "spawn is a safe clearing, not a town"
    },
    {
      "id": "hamlet",
      "chunkRing": [3, 10],
      "chancePerEligibleChunk": 0.035,
      "sizeClass": "small",
      "footprintCells": [18, 18],
      "buildingRanks": ["r1"],
      "buildingCount": [2, 4],
      "stockTier": 1,
      "services": [
        "basic_crafting",
        "camp_trade",
        "rest"
      ]
    },
    {
      "id": "village",
      "chunkRing": [11, 28],
