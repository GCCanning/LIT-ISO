      "services": [
        "advanced_crafting",
        "forge",
        "alchemy",
        "guild_board",
        "library",
        "market_trade",
        "tavern_jobs",
        "specialty_vendor",
        "rest"
      ]
    }
  ],
  "buildingPool": [
    {"id": "tavern_r1", "rank": "r1", "services": ["rest", "tavern_jobs"], "footprint": "2x2"},
    {"id": "tavern_r2", "rank": "r2", "services": ["rest", "tavern_jobs"], "footprint": "3x3"},
    {"id": "tavern_r3", "rank": "r3", "services": ["rest", "tavern_jobs"], "footprint": "4x4"},
