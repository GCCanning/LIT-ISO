  "hotbar_target": {
    "visible_slots": 9,
    "row_model": "visible slot maps to inventory[activeRow * visibleSlots + visibleIndex]",
    "inputs": [
      "number keys select visible slot",
      "mouse wheel cycles selected slot",
      "shift + mouse wheel cycles hotbar row",
      "inventory tab highlights exposed row"
    ],
    "save_fields": [
      "hotbarSelectedVisibleSlot",
      "hotbarActiveRow"
    ]
  },
  "ability_wheel_target": {
    "quick_slots": ["Q", "E", "R", "F"],
    "open_input": "hold X",
    "behaviors": [
      "flick and release to cast",
      "drag learned ability onto quick slot to assign",
      "show cooldown and cost state",
      "group learned abilities by element",
      "support keyboard/mouse now and controller later"
    ]
  }
