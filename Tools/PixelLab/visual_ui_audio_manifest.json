{
  "version": 1,
  "project": "LIT-ISO",
  "style_contract": {
    "source": "PixelLab",
    "summary": "Crisp isometric pixel-art dark fantasy UI and scene assets. Deep navy-charcoal panels, antique brass accents, readable slots and tabs, no baked text, no copyrighted style imitation.",
    "component_rules": [
      "transparent background for UI components",
      "no text baked into sprites",
      "point-filtered pixel edges",
      "9-slice friendly borders for panels, buttons, tabs, and slots",
      "full-screen backgrounds may include environment art but must reserve readable negative space"
    ]
  },
  "runtime_paths": {
    "menu": "Assets/Resources/UI/Menu",
    "in_game": "Assets/Resources/UI/InGame",
    "class_selection": "Assets/Resources/UI/ClassSelection",
    "loading": "Assets/Resources/UI/Loading",
    "audio_sfx": "Assets/Resources/Audio/SFX",
    "audio_biome_ambient": "Assets/Resources/Audio/Ambient/Biome"
  },
  "screen_backgrounds": [
    {
      "id": "main_menu",
      "target": "Assets/Resources/UI/Menu/background.png",
      "size": "1920x1080",
      "prompt_role": "campfire, tavern, portal, playable world signal, left-side negative space for menu"
    },
    {
      "id": "loading_default",
      "target": "Assets/Resources/UI/Loading/background_default.png",
      "size": "1920x1080",
      "prompt_role": "travel transition art with camp path, faint System glyphs, readable bottom progress area"
    },
    {
      "id": "class_selection",
      "target": "Assets/Resources/UI/ClassSelection/background.png",
      "size": "1920x1080",
      "prompt_role": "cosmic System void, floating player silhouette, class-offer ceremony"
    },
    {
      "id": "character_creation",
      "target": "Assets/Resources/UI/Menu/background_character_creation.png",
      "size": "1920x1080",
      "prompt_role": "Stardew-clean character setup space, player preview area, System void mood"
    },
    {
      "id": "world_creation",
      "target": "Assets/Resources/UI/Menu/background_world_creation.png",
      "size": "1920x1080",
      "prompt_role": "isometric map table, seed/world setup mood, readable center-left panel area"
    },
    {
      "id": "death_respawn",
      "target": "Assets/Resources/UI/Loading/background_death_respawn.png",
      "size": "1920x1080",
      "prompt_role": "quiet campfire respawn atmosphere, dark edges, no gore"
    }
  ],
